rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isRecipient(recipientIds) {
      return isAuthenticated() && request.auth.uid in recipientIds;
    }

    function isParticipant(participantIds) {
      return isAuthenticated() && request.auth.uid in participantIds;
    }

    function isOpenDate(openDate) {
      return request.time >= openDate;
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own document
      allow read, write: if isOwner(userId);

      // Allow reading public key for encryption purposes
      allow read: if isAuthenticated() &&
                     request.resource.data.keys().hasOnly(['publicKey']);
    }

    // Messages collection
    match /messages/{messageId} {
      // Owner can always read their own messages
      allow read: if isOwner(resource.data.ownerId);

      // Recipients can read only if open date has passed
      allow read: if isRecipient(resource.data.recipientIds) &&
                     (isOpenDate(resource.data.openDate) || resource.data.isOpened);

      // Only owner can create messages
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.isOpened == false;

      // Only owner can update (e.g., mark as opened)
      allow update: if isOwner(resource.data.ownerId) ||
                       (isRecipient(resource.data.recipientIds) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['isOpened', 'openedAt']));

      // Only owner can delete
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Events collection
    match /events/{eventId} {
      // Only owner can read, write, and delete their events
      allow read, write, delete: if isOwner(resource.data.userId);

      // Only authenticated users can create events
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time;
    }

    // Capsules collection
    match /capsules/{capsuleId} {
      // Owner can always read/write
      allow read, write: if isOwner(resource.data.ownerId);

      // Participants can read
      allow read: if isParticipant(resource.data.participantIds);

      // Participants can update only openedBy field
      allow update: if isParticipant(resource.data.participantIds) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['openedBy', 'isOpened', 'openedAt']);

      // Only authenticated users can create
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.participantIds;
    }

    // Insights collection
    match /insights/{insightId} {
      // Only owner can read their insights
      allow read: if isOwner(resource.data.userId);

      // Only server (Cloud Functions) can write insights
      allow write: if false;
    }

    // Invitations collection
    match /invitations/{invitationId} {
      // Sender can read their own invitations
      allow read: if isOwner(resource.data.fromUserId);

      // Recipient can read invitations sent to them
      allow read: if isAuthenticated() &&
                     request.auth.token.email == resource.data.toEmail;

      // Only authenticated users can create invitations
      allow create: if isAuthenticated() &&
                       request.resource.data.fromUserId == request.auth.uid;

      // Recipient can update to accept invitation
      allow update: if isAuthenticated() &&
                       request.auth.token.email == resource.data.toEmail &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['accepted', 'acceptedAt']);

      // Only sender can delete
      allow delete: if isOwner(resource.data.fromUserId);
    }

    // Analytics collection (write-only for privacy)
    match /analytics/{analyticsId} {
      allow read: if false; // No one can read analytics
      allow write: if isAuthenticated(); // Users can log their own events
    }

    // Admin config (read-only for authenticated users)
    match /admin/config {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin SDK can write
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
